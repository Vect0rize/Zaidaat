# Server & Port Configuration
NODE_ENV=development
PORT=4000
CLIENT_PORT=3000
APP_URL=http://localhost:3000

# SQLite Database Path (relative to project root or absolute)
DATABASE_PATH=./data/zaidaat.db

# Authentication & Security
# IMPORTANT: Replace JWT_SECRET with a long random string in production!
JWT_SECRET=replace-with-strong-32-char-random-secret-key
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Development Auth Helpers (set to false in production)
ALLOW_DEV_OTP=true
ALLOW_DEV_RESET_PREVIEW=true

# Optional: Google OAuth 2.0 (leave blank for safe dev mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: SMS OTP Provider (MSG91 / Twilio) - leave blank for safe dev OTP fallback
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional: Payment Gateway for Pro Subscriptions (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Upload Limits
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
